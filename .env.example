# SMTP Email Config
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_PORT=
MAIL_SERVER=
MAIL_STARTTLS=
MAIL_SSL_TLS=

# Razorpay Key ID and Key Secret from the Razorpay dashboard.
ROZAR_PAY_API_KEY=
ROZAR_PAY_SECRET=

# Storj Credentials
STORJ_ACCESS_KEY=
STORJ_SECRET_KEY=
STORJ_BUCKET=
STORJ_S3_ENDPOINT=https://gateway.storjshare.io
STORJ_REGION=us-east-1
STORJ_PUBLIC_BASE_URL=https://link.storjshare.io/raw


# OAuth provider secrets stay on the backend. Register these callback URLs
# exactly as shown in the Google/Facebook provider consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback


FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0
FRONTEND_BASE_URL=http://localhost:5173
OAUTH_COOKIE_SECURE=false

# Backend database connection. Empty values use the development defaults.
DATABASE_USER=root
DATABASE_PASSWORD=admin
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=gym_management
DATABASE_DRIVER=mysql+aiomysql
