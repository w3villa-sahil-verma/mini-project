
erDiagram

    USER {
        int id PK
        string email UK
        string role "user or admin"
        boolean email_verified
        string account_status
        datetime created_at
        datetime updated_at
    }

    USER_PROFILE {
        int id PK
        int user_id FK, UK
        string name
        string profile_picture_url
        string address
        decimal latitude
        decimal longitude
        datetime created_at
        datetime updated_at
    }

    CREDENTIAL {
        int id PK
        int user_id FK
        string password_hash
        string type "password, google, facebook, standard"
        datetime created_at
        datetime updated_at
    }

    PLAN {
        int id PK
        string name "Free, Silver, Gold"
        int duration_hours "1, 6, or 12"
        int price_minor
        string currency
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    SUBSCRIPTION {
        int id PK
        int user_id FK
        int plan_id FK
        string status "pending, active, expired, cancelled"
        datetime starts_at
        datetime expires_at
        datetime created_at
        datetime updated_at
    }

    PAYMENT {
        int id PK
        int user_id FK
        int subscription_id FK
        string provider "Stripe"
        string provider_payment_id
        int amount_minor
        string currency
        string status "pending, succeeded, failed"
        datetime created_at
        datetime updated_at
    }

    PAYMENT_WEBHOOK_EVENT {
        int id PK
        string provider_event_id UK
        string event_type
        boolean processed
        datetime created_at
    }

    USER ||--o| USER_PROFILE : has
    USER ||--o{ CREDENTIAL : authenticates_with
    USER ||--o{ SUBSCRIPTION : owns
    PLAN ||--o{ SUBSCRIPTION : selected_for
    USER ||--o{ PAYMENT : makes
    SUBSCRIPTION ||--o{ PAYMENT : has
